# ==============================================================================
# CONFIGURAÇÕES BÁSICAS DO DJANGO
# ==============================================================================
DEBUG=True
SECRET_KEY=django-insecure-change-me-in-production-replace-with-strong-secret
ALLOWED_HOSTS=localhost,127.0.0.1

# ==============================================================================
# BANCO DE DADOS (PostgreSQL / Fallback Local SQLite)
# ==============================================================================
# Defina USE_SQLITE=True apenas para testes locais rápidos sem PostgreSQL ativo
USE_SQLITE=False
DB_NAME=catalog_engine_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# ==============================================================================
# FILAS E AGENDAMENTO (Celery & Redis)
# ==============================================================================
REDIS_URL=redis://127.0.0.1:6379/0

# ==============================================================================
# SEGURANÇA E GOVERNANÇA OPERACIONAL
# ==============================================================================
# Trava global de escrita nos marketplaces (MANTENHA False durante desenvolvimento/homologação)
# Enquanto False, nenhuma requisição POST/PUT/PATCH/DELETE de edição de anúncio é enviada.
MARKETPLACE_WRITE_ENABLED=False

# Chave Fernet (32 bytes url-safe base64) para criptografia em repouso de tokens OAuth/chaves
# Gere uma com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# ==============================================================================
# INTELIGÊNCIA ARTIFICIAL (Google Gemini)
# ==============================================================================
GEMINI_API_KEY=

# ==============================================================================
# INTEGRAÇÃO MERCADO LIVRE (OAuth 2.0)
# ==============================================================================
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=http://localhost:8000/vault/ml/callback/
